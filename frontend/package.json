{
  "name": "parkcloud-desktop",
  "version": "1.0.0",
  "description": "ParkCloud Smart Parking Management Desktop Application",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "electron .",
    "package": "vite build && electron-packager . ParkCloud --platform=win32 --arch=x64 --out=dist_electron --overwrite --prune=true"
  },
  "dependencies": {
    "chart.js": "^4.4.7",
    "lucide-react": "^0.475.0",
    "react": "^18.3.1",
    "react-chartjs-2": "^5.3.0",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "electron-packager": "^17.1.2",
    "vite": "^6.1.0"
  },
  "build": {
    "appId": "in.parkcloud.desktop",
    "productName": "ParkCloud",
    "directories": {
      "output": "dist_electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "artifactName": "ParkCloud-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "uninstallDisplayName": "ParkCloud Smart Parking"
    }
  }
}
